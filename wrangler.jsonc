{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-panel-test1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bcd5c4d7-e934-4da8-90c0-ce8020662186","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0b7d3dca23fa451e9a4a255ce8870108" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
